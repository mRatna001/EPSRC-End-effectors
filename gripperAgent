#!/usr/bin/env python3
"""
LLM Grasp Planning Agent
Usage: python3 grasp_agent.py --gripper mg10 --task "pick up a flat steel plate"
"""
import anthropic
import argparse
import yaml
import os
import re

def load_config(gripper_name):
    config_path = f"config/{gripper_name}.yaml"
    if not os.path.exists(config_path):
        raise FileNotFoundError(f"No config found for {gripper_name}")
    with open(config_path) as f:
        return yaml.safe_load(f)

def plan_grasp(gripper_name, task):
    config = load_config(gripper_name)
    config_str = yaml.dump(config)

    client = anthropic.Anthropic()
    
    message = client.messages.create(
        model="claude-sonnet-4-6",
        max_tokens=1000,
        system="""You are a robotics grasp planning agent. Given a gripper config and task, output ONLY executable Python commands using the gripper object 'g'. No explanation, no imports, just the commands. Example:
g.grip(80)
import time; time.sleep(1)
print(g.get_status())""",
        messages=[{
            "role": "user",
            "content": f"Gripper config:\n{config_str}\n\nTask: {task}\n\nOutput only the Python commands to execute this task."
        }]
    )
    
    return message.content[0].text

def main():
    parser = argparse.ArgumentParser()
    parser.add_argument('--gripper', required=True, help='Gripper name e.g. mg10, fg15, rg6, sg')
    parser.add_argument('--task', required=True, help='Task description')
    parser.add_argument('--ip', default='192.168.1.1')
    parser.add_argument('--run', action='store_true', help='Actually run the commands')
    args = parser.parse_args()

    print(f"\nGripper: {args.gripper}")
    print(f"Task:    {args.task}")
    print(f"\nPlanning grasp...")
    
    commands = plan_grasp(args.gripper, args.task)
    
    print(f"\nCommands:\n{'-'*40}")
    print(commands)
    print('-'*40)

    if args.run:
        print("\nExecuting...")
        # dynamic import based on config
        config = load_config(args.gripper)
        module_name, class_name = config['driver'].rsplit('.', 1)
        import importlib
        mod = importlib.import_module(f"gripper_driver.{module_name}")
        cls = getattr(mod, class_name)
        unit_id = config.get('unit_id', 66)
        gripper_arg = config.get('gripper_arg')
        if gripper_arg:
            g = cls(gripper_arg, args.ip, unit_id=unit_id)
        else:
            g = cls(args.ip, unit_id=unit_id)
        exec(commands)
    else:
        print("\nAdd --run to execute on real hardware.")

if __name__ == "__main__":
    main()
